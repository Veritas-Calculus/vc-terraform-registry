# Copy to .env and fill in the required values before running docker-compose.

# Server
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
# release (default) enforces a strong AUTH_SECRETKEY and hides debug routes.
SERVER_MODE=release

# Storage / database
DATABASE_URL=sqlite:///data/registry.db
STORAGE_PATH=/data/registry

# Authentication
AUTH_ENABLED=true
# REQUIRED. Generate a strong random key; the server refuses to start in release
# mode with a missing, placeholder, or short (<32 char) key:
#   openssl rand -base64 32
AUTH_SECRETKEY=

# Initial admin password. Leave blank to have the server generate a random one
# and print it once at first boot. Set it to choose your own.
#   openssl rand -base64 24
ADMIN_PASSWORD=

# Comma-separated list of browser origins allowed via CORS. "*" allows any
# origin (no credentials are used; the API authenticates with a Bearer token).
CORS_ALLOWED_ORIGINS=*

# Logging
LOG_LEVEL=info
